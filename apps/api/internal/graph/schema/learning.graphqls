scalar Time
scalar Int64

enum RunKind {
  PRACTICE
  DIAGNOSTIC
  SIMULATION
}

enum RunStatus {
  ACTIVE
  SUBMITTED
  ABANDONED
}

enum AttemptOutcome {
  CORRECT
  INCORRECT
  PARTIAL
  SKIPPED
  UNGRADED
}

enum GradingKind {
  AUTO
  RUBRIC_SELF
  AI_ASSISTED
  HUMAN
}

enum ClientGradingKind {
  AUTO
  RUBRIC_SELF
}

type Attempt {
  id: ID!
  runItemId: ID
  taskId: ID!
  examPosition: Int!
  mode: RunKind!
  startedAt: Time!
  submittedAt: Time!
  activeDurationMs: Int64
  answer: String
  outcome: AttemptOutcome!
  helpLevel: Int!
  gradingKind: GradingKind!
  earnedPoints: Int
  maxPoints: Int
  taskRevision: String
}

type RunItem {
  id: ID!
  taskId: ID!
  ordinal: Int!
  examPosition: Int!
  topic: ID!
  maxPoints: Int
  taskRevision: String!
  """Returns the latest attempts in chronological order, up to a limit of 20."""
  recentAttempts(limit: Int! = 5): [Attempt!]!
}

type RunCheckpointDraft {
  runItemId: ID!
  answer: String!
}

type RunCheckpoint {
  version: Int64!
  currentOrdinal: Int!
  activeDurationMs: Int64
  updatedAt: Time!
  drafts: [RunCheckpointDraft!]!
}

type Run {
  id: ID!
  kind: RunKind!
  status: RunStatus!
  blueprintVersion: String!
  contentRevision: String!
  startedAt: Time!
  deadlineAt: Time
  submittedAt: Time
  activeDurationMs: Int64
  """Mutable active state; absent after submit or abandon."""
  checkpoint: RunCheckpoint
  items: [RunItem!]!
}

type RunSummary {
  id: ID!
  kind: RunKind!
  status: RunStatus!
  blueprintVersion: String!
  contentRevision: String!
  startedAt: Time!
  deadlineAt: Time
  submittedAt: Time
  activeDurationMs: Int64
  taskIds: [ID!]!
  itemCount: Int!
  completedItemCount: Int!
  correctItemCount: Int!
  earnedPoints: Int
  maxPoints: Int
}

type CompletedSimulationRunItem {
  taskId: ID!
  examPosition: Int!
  topic: ID!
  maxPoints: Int
  taskRevision: String!
  answer: String
  outcome: AttemptOutcome
  gradingKind: GradingKind
  earnedPoints: Int
}

type CompletedSimulationRun {
  id: ID!
  blueprintVersion: String!
  contentRevision: String!
  startedAt: Time!
  deadlineAt: Time
  submittedAt: Time!
  activeDurationMs: Int64
  items: [CompletedSimulationRunItem!]!
}

input NewRunItemInput {
  id: ID!
  taskId: ID!
  examPosition: Int!
  topic: ID!
  maxPoints: Int
  taskRevision: String!
}

input StartRunInput {
  id: ID!
  kind: RunKind!
  blueprintVersion: String!
  contentRevision: String!
  startedAt: Time!
  deadlineAt: Time
  items: [NewRunItemInput!]!
}

input StandaloneAttemptTargetInput {
  taskId: ID!
  examPosition: Int!
  taskRevision: String!
  maxPoints: Int
}

input RecordAttemptInput {
  id: ID!
  runItemId: ID
  standalone: StandaloneAttemptTargetInput
  startedAt: Time!
  submittedAt: Time!
  activeDurationMs: Int64
  answer: String
  outcome: AttemptOutcome!
  helpLevel: Int! = 0
  gradingKind: ClientGradingKind!
  earnedPoints: Int
}

input SubmitRunInput {
  id: ID!
  submittedAt: Time!
  activeDurationMs: Int64
}

input RunCheckpointDraftInput {
  runItemId: ID!
  answer: String!
}

input CheckpointRunInput {
  id: ID!
  """Use zero for the first write, then the version returned by the server."""
  expectedVersion: Int64!
  currentOrdinal: Int!
  activeDurationMs: Int64
  """Full draft replacement; omitting an item removes its previous draft."""
  drafts: [RunCheckpointDraftInput!]! = []
}

input AbandonRunInput {
  id: ID!
}

type Query {
  run(id: ID!): Run
  runs(limit: Int! = 20): [RunSummary!]!
  """Returns the latest submitted simulation runs, up to a limit of 20."""
  completedSimulationRuns(limit: Int! = 20): [CompletedSimulationRun!]!
  """Returns the most recent attempts in chronological order, up to a limit of 1000."""
  attempts(limit: Int! = 100): [Attempt!]!
}

type Mutation {
  startRun(input: StartRunInput!): Run!
  recordAttempt(input: RecordAttemptInput!): Attempt!
  """Atomically replace active drafts when expectedVersion is current."""
  checkpointRun(input: CheckpointRunInput!): RunCheckpoint!
  submitRun(input: SubmitRunInput!): Run!
  """Idempotently abandon an active run and remove its mutable checkpoint."""
  abandonRun(input: AbandonRunInput!): Run!
}
