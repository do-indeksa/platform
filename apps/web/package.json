    "test:visual:update": "bash scripts/update-visual-snapshots.sh",
    "generate:api": "openapi-typescript ../api/api/openapi.yaml -o src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "katex": "^0.17.0",
    "lucide-react": "^1.31.0",
    "mathjs": "^15.2.0",
    "next": "16.3.0",
    "next-intl": "^4.13.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "uuid": "14.0.1",
    "yaml": "^2.9.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
